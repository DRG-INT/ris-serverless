generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String    @id @default(uuid())
  email                  String    @unique
  passwordHash           String    @map("password_hash")
  emailVerifiedAt        DateTime? @map("email_verified_at")
  emailVerificationToken String?   @map("email_verification_token")
  passwordResetToken     String?   @map("password_reset_token")
  passwordResetExpiresAt DateTime? @map("password_reset_expires_at")
  lastLoginAt            DateTime? @map("last_login_at")
  status                 String    @default("active")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @default(now()) @map("updated_at")

  refreshTokens RefreshToken[]
  userRoles     UserRole[]
  members       Member[]
  staffAccounts Staff[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Role {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid())
  name        String @unique
  description String?
  resource    String
  action      String
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId         String @map("user_id")
  roleId         String @map("role_id")
  organizationId String @map("organization_id")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, roleId, organizationId])
  @@map("user_roles")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  status    String   @default("active")
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  userRoles        UserRole[]
  locations        Location[]
  members          Member[]
  staff            Staff[]
  facilities       Facility[]
  courses          Course[]
  activities       Activity[]
  memberships      Membership[]
  taxSettings      TaxSetting[]
  currencySettings CurrencySetting[]
  classSessions    ClassSession[]
  bookings         Booking[]
  passes           Pass[]
  payments         Payment[]
  invoices         Invoice[]
  auditLogs        AuditLog[]
  analyticsEvents  AnalyticsEvent[]
  integrations     Integration[]
  automationRules  AutomationRule[]
  messages         Message[]
  leads            Lead[]
  attendances      Attendance[]
  customFieldDefinitions CustomFieldDefinition[]

  @@map("organizations")
}

model Location {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  address        Json      @default("{}")
  timezone       String    @default("UTC")
  phone          String?
  email          String?
  status         String    @default("active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @map("updated_at")

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessHours  BusinessHour[]
  classSessions  ClassSession[]
  staffAssignments StaffAssignment[]

  @@map("locations")
}

model BusinessHour {
  id         String   @id @default(uuid())
  locationId String   @map("location_id")
  dayOfWeek  Int      @map("day_of_week")
  openTime   DateTime @db.Time @map("open_time")
  closeTime  DateTime @db.Time @map("close_time")
  isClosed   Boolean  @default(false) @map("is_closed")

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, dayOfWeek])
  @@map("business_hours")
}

model TaxSetting {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  rate           Decimal  @db.Decimal(5, 4)
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("tax_settings")
}

model CurrencySetting {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  currencyCode   String   @db.Char(3) @map("currency_code")
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("currency_settings")
}

model Member {
  id                  String    @id @default(uuid())
  organizationId      String    @map("organization_id")
  userId              String?   @map("user_id")
  firstName           String    @map("first_name")
  lastName            String    @map("last_name")
  email               String
  phone               String?
  birthDate           DateTime? @map("birth_date")
  emergencyContact    Json       @default("{}") @map("emergency_contact")
  status              String     @default("active")
  registrationDate    DateTime   @default(now()) @map("registration_date")
  notes               String?
  tags                Json       @default("[]")
  communicationPrefs  Json       @default("{}") @map("communication_preferences")
  marketingStatus     Boolean    @default(true) @map("marketing_status")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @default(now()) @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  consents       MemberConsent[]
  bookings       Booking[]
  memberships    Membership[]
  attendances    Attendance[]
  leads          Lead[]
  passes         Pass[]
  payments       Payment[]
  invoices       Invoice[]

  @@unique([organizationId, email])
  @@map("members")
}

model MemberConsent {
  id        String   @id @default(uuid())
  memberId  String   @map("member_id")
  type      String   @map("consent_type")
  granted   Boolean
  grantedAt DateTime @default(now()) @map("granted_at")
  revokedAt DateTime? @map("revoked_at")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, type])
  @@map("member_consents")
}

model CustomFieldDefinition {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  fieldType      String   @map("field_type")
  options        Json      @default("[]")
  visibility     String    @default("STAFF")
  isRequired     Boolean   @default(false) @map("is_required")
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  values       CustomFieldValue[]

  @@map("custom_field_definitions")
}

model CustomFieldValue {
  id           String   @id @default(uuid())
  definitionId String   @map("definition_id")
  entityType   String   @map("entity_type")
  entityId     String   @map("entity_id")
  value        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @map("updated_at")

  definition CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([definitionId, entityType, entityId])
  @@map("custom_field_values")
}

model Staff {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String?  @map("user_id")
  firstName      String   @map("first_name")
  lastName       String   @map("last_name")
  email          String
  phone          String?
  bio            String?
  qualifications Json      @default("[]")
  status         String    @default("active")
  hireDate       DateTime? @map("hire_date")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @map("updated_at")

  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  availability     StaffAvailability[]
  instructor       InstructorProfile?
  assignments      StaffAssignment[]
  commissions      StaffCommission[]
  payouts          InstructorPayout[]

  @@unique([organizationId, email])
  @@map("staff")
}

model StaffAvailability {
  id       String   @id @default(uuid())
  staffId  String   @map("staff_id")
  dayOfWeek Int     @map("day_of_week")
  startTime DateTime @db.Time @map("start_time")
  endTime   DateTime @db.Time @map("end_time")
  createdAt DateTime @default(now()) @map("created_at")

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("staff_availability")
}

model InstructorProfile {
  id             String    @id @default(uuid())
  staffId        String    @map("staff_id") @unique
  specialties    Json       @default("[]")
  hourlyRate     Decimal?  @db.Decimal(10, 2) @map("hourly_rate")
  commissionRate Decimal?  @db.Decimal(5, 4) @map("commission_rate")
  rating         Decimal?  @db.Decimal(3, 2)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @map("updated_at")

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("instructor_profiles")
}

model StaffAssignment {
  id           String   @id @default(uuid())
  staffId      String   @map("staff_id")
  locationId   String   @map("location_id")
  assignedAt   DateTime @default(now()) @map("assigned_at")

  staff    Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([staffId, locationId])
  @@map("staff_assignments")
}

model StaffCommission {
  id         String    @id @default(uuid())
  staffId    String    @map("staff_id")
  amount     Decimal   @db.Decimal(10, 2)
  type       String
  sessionId  String?   @map("session_id")
  paidAt     DateTime? @map("paid_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("staff_commissions")
}

model InstructorPayout {
  id           String    @id @default(uuid())
  staffId      String    @map("staff_id")
  amount       Decimal   @db.Decimal(10, 2)
  periodStart  DateTime  @map("period_start")
  periodEnd    DateTime  @map("period_end")
  status       String    @default("pending")
  paidAt       DateTime? @map("paid_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("instructor_payouts")
}

model Facility {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?
  status         String    @default("active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rooms        Room[]
  resources    Resource[]

  @@map("facilities")
}

model Room {
  id         String   @id @default(uuid())
  facilityId String   @map("facility_id")
  name       String
  capacity   Int
  status     String   @default("active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @map("updated_at")

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@map("rooms")
}

model Resource {
  id         String   @id @default(uuid())
  facilityId String?  @map("facility_id")
  name       String
  type       String
  capacity   Int?
  status     String   @default("active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @map("updated_at")

  facility Facility? @relation(fields: [facilityId], references: [id], onDelete: SetNull)

  @@map("resources")
}

model Course {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?
  category       String?
  capacity       Int?
  duration       Int?
  eligibility    Json       @default("{}")
  bookingRules   Json       @default("{}") @map("booking_rules")
  cancellationRules Json    @default("{}") @map("cancellation_rules")
  pricingRules   Json       @default("{}") @map("pricing_rules")
  membershipCompatibility Json @default("[]") @map("membership_compatibility")
  status         String    @default("active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activities   Activity[]

  @@map("courses")
}

model Activity {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  courseId       String?  @map("course_id")
  type           String
  name           String
  description    String?
  facilityId     String?  @map("facility_id")
  instructorId   String?  @map("instructor_id")
  resourceId     String?  @map("resource_id")
  capacity       Int?
  duration       Int?
  price          Decimal? @db.Decimal(10, 2)
  membershipRequired String? @map("membership_required")
  status         String    @default("active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course       Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  sessions     ClassSession[]

  @@map("activities")
}

model ClassSession {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  activityId     String    @map("activity_id")
  locationId     String    @map("location_id")
  instructorId   String?   @map("instructor_id")
  startsAt       DateTime  @map("starts_at")
  endsAt         DateTime  @map("ends_at")
  capacity       Int?
  isOnline       Boolean   @default(false) @map("is_online")
  status         String    @default("scheduled")
  cancelledAt    DateTime? @map("cancelled_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activity     Activity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  bookings     Booking[]
  attendances  Attendance[]

  @@index([organizationId, startsAt])
  @@index([activityId, startsAt])
  @@map("class_sessions")
}

model RecurringSchedule {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  activityId     String   @map("activity_id")
  locationId     String   @map("location_id")
  instructorId   String?  @map("instructor_id")
  dayOfWeek      Int      @map("day_of_week")
  startsAt       DateTime @db.Time @map("starts_at")
  endsAt         DateTime @db.Time @map("ends_at")
  startsOn       DateTime @map("starts_on")
  endsOn         DateTime? @map("ends_on")
  status         String   @default("active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @map("updated_at")

  @@map("recurring_schedules")
}

model ScheduleException {
  id           String   @id @default(uuid())
  sessionId    String   @map("session_id")
  type         String
  reason       String?
  newStartAt   DateTime? @map("new_start_at")
  newEndAt     DateTime? @map("new_end_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("schedule_exceptions")
}

model Booking {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  memberId       String   @map("member_id")
  sessionId      String   @map("session_id")
  status         String    @default("reserved")
  source         String    @default("api")
  idempotencyKey String?   @unique @map("idempotency_key")
  cancelledAt    DateTime? @map("cancelled_at")
  cancellationReason String? @map("cancellation_reason")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  session      ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  creditTx     CreditTransaction?

  @@unique([sessionId, memberId])
  @@index([organizationId, memberId, sessionId])
  @@index([sessionId, status])
  @@index([idempotencyKey])
  @@map("bookings")
}

model WaitlistEntry {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  sessionId      String   @map("session_id")
  memberId       String   @map("member_id")
  position       Int
  notifiedAt     DateTime? @map("notified_at")
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@unique([sessionId, memberId])
  @@index([sessionId, position])
  @@map("waitlist_entries")
}

model MembershipProduct {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?
  type           String
  price          Decimal  @db.Decimal(10, 2)
  currency       String   @default("HUF")
  entryLimit     Int?     @map("entry_limit")
  durationDays   Int      @map("duration_days")
  isRecurring    Boolean  @default(false) @map("is_recurring")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @map("updated_at")

  memberships Membership[]

  @@map("membership_products")
}

model Membership {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  memberId       String   @map("member_id")
  productId      String   @map("product_id")
  status         String    @default("pending")
  startsAt       DateTime  @map("starts_at")
  expiresAt      DateTime? @map("expires_at")
  frozenAt       DateTime? @map("frozen_at")
  unfrozenAt     DateTime? @map("unfrozen_at")
  cancelledAt    DateTime? @map("cancelled_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @map("updated_at")

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member        Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  product       MembershipProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  freezes       MembershipFreeze[]
  renewals      MembershipRenewal[]
  cancellations MembershipCancellation[]

  @@index([memberId, status])
  @@map("memberships")
}

model MembershipFreeze {
  id           String   @id @default(uuid())
  membershipId String   @map("membership_id")
  reason       String?
  startsAt     DateTime @map("starts_at")
  endsAt       DateTime @map("ends_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@map("membership_freezes")
}

model MembershipRenewal {
  id           String   @id @default(uuid())
  membershipId String   @map("membership_id")
  paymentId    String?  @map("payment_id")
  renewedAt    DateTime @default(now()) @map("renewed_at")
  createdAt    DateTime @default(now()) @map("created_at")

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@map("membership_renewals")
}

model MembershipCancellation {
  id           String   @id @default(uuid())
  membershipId String   @map("membership_id")
  reason       String?
  cancelledAt  DateTime @default(now()) @map("cancelled_at")

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@map("membership_cancellations")
}

model Pass {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  memberId       String   @map("member_id")
  type           String
  creditsTotal   Int      @map("credits_total")
  creditsUsed    Int      @default(0) @map("credits_used")
  expiresAt      DateTime? @map("expires_at")
  status         String    @default("active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  creditTx     CreditTransaction?

  @@map("passes")
}

model CreditTransaction {
  id          String   @id @default(uuid())
  passId      String   @unique @map("pass_id")
  type        String
  amount      Int
  balanceAfter Int     @map("balance_after")
  refId       String?  @unique @map("ref_id")
  refType     String?  @map("ref_type")
  createdAt   DateTime  @default(now()) @map("created_at")

  pass   Pass     @relation(fields: [passId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [refId], references: [id], onDelete: SetNull)

  @@index([passId, createdAt])
  @@map("credit_transactions")
}

model Payment {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  memberId       String   @map("member_id")
  amount         Decimal  @db.Decimal(10, 2)
  currency       String   @default("HUF")
  status         String    @default("pending")
  provider       String
  providerRef    String?   @map("provider_ref")
  idempotencyKey String?   @unique @map("idempotency_key")
  metadata       Json       @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  invoices     Invoice[]

  @@index([idempotencyKey])
  @@map("payments")
}

model Invoice {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  memberId       String   @map("member_id")
  paymentId      String?  @map("payment_id")
  status         String    @default("draft")
  total          Decimal  @db.Decimal(10, 2)
  currency       String   @default("HUF")
  issuedAt       DateTime? @map("issued_at")
  paidAt         DateTime? @map("paid_at")
  voidedAt       DateTime? @map("voided_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  payment      Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  items        InvoiceItem[]

  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String   @map("invoice_id")
  description String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2) @map("unit_price")
  taxRate     Decimal? @db.Decimal(5, 4) @map("tax_rate")
  createdAt   DateTime @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model Attendance {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  memberId       String   @map("member_id")
  sessionId      String   @map("session_id")
  method         String   @default("manual")
  checkedInAt    DateTime @default(now()) @map("checked_in_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  session      ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([memberId, sessionId])
  @@map("attendance")
}

model Lead {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  memberId       String?  @map("member_id")
  source         String
  status         String   @default("new")
  firstContactAt DateTime? @map("first_contact_at")
  convertedAt    DateTime? @map("converted_at")
  lostAt         DateTime? @map("lost_at")
  assignedTo     String?  @map("assigned_to")
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       Member?      @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@map("leads")
}

model Message {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  channel        String
  recipientType  String   @map("recipient_type")
  recipientId    String   @map("recipient_id")
  subject        String?
  body           String
  status         String    @default("pending")
  sentAt         DateTime? @map("sent_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model MessageTemplate {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  channel        String
  subject        String?
  body           String
  variables      Json       @default("[]")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @map("updated_at")

  @@map("message_templates")
}

model Campaign {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  channel        String
  templateId     String?  @map("template_id")
  audienceFilter Json       @default("{}")
  scheduledAt    DateTime?  @map("scheduled_at")
  sentAt         DateTime?  @map("sent_at")
  status         String    @default("draft")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("campaigns")
}

model AutomationRule {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  event          String
  conditions     Json       @default("{}")
  actions        Json       @default("[]")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("automation_rules")
}

model AnalyticsEvent {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  eventType      String   @map("event_type")
  entityType     String?  @map("entity_type")
  entityId       String?  @map("entity_id")
  properties     Json       @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, eventType, createdAt])
  @@map("analytics_events")
}

model Integration {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  provider       String
  config         Json       @default("{}")
  status         String    @default("inactive")
  lastSyncAt     DateTime? @map("last_sync_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@map("integrations")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  actorId        String?  @map("actor_id")
  action         String
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  ip             String?
  metadata       Json       @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, entityType, createdAt])
  @@index([organizationId, actorId, createdAt])
  @@map("audit_logs")
}
