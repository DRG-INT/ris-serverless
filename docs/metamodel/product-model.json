{
  "product": {
    "name": "Recreation in Sport",
    "version": "1.0.0",
    "description": "API-first modular sports and recreation management platform"
  },
  "domains": [
    "identity",
    "organizations",
    "locations",
    "members",
    "staff",
    "facilities",
    "resources",
    "courses",
    "activities",
    "scheduling",
    "bookings",
    "memberships",
    "passes",
    "payments",
    "billing",
    "attendance",
    "crm",
    "messaging",
    "automation",
    "analytics",
    "integrations",
    "audit",
    "reports"
  ],
  "entities": [
    { "name": "User", "module": "identity", "purpose": "Authentication and user identity" },
    { "name": "RefreshToken", "module": "identity", "purpose": "Refresh token storage" },
    { "name": "Role", "module": "identity", "purpose": "RBAC role" },
    { "name": "Permission", "module": "identity", "purpose": "Granular permission" },
    { "name": "UserRole", "module": "identity", "purpose": "User role assignment" },
    { "name": "Organization", "module": "organizations", "purpose": "Tenant root aggregate" },
    { "name": "Location", "module": "locations", "purpose": "Physical location" },
    { "name": "BusinessHour", "module": "locations", "purpose": "Location business hours" },
    { "name": "TaxSetting", "module": "organizations", "purpose": "Tax configuration" },
    { "name": "CurrencySetting", "module": "organizations", "purpose": "Currency configuration" },
    { "name": "Member", "module": "members", "purpose": "Customer/member profile" },
    { "name": "MemberConsent", "module": "members", "purpose": "GDPR consent tracking" },
    { "name": "CustomFieldDefinition", "module": "members", "purpose": "Custom field schema" },
    { "name": "CustomFieldValue", "module": "members", "purpose": "Custom field value" },
    { "name": "Staff", "module": "staff", "purpose": "Instructor/staff profile" },
    { "name": "StaffAvailability", "module": "staff", "purpose": "Staff availability schedule" },
    { "name": "InstructorProfile", "module": "staff", "purpose": "Instructor-specific data" },
    { "name": "StaffAssignment", "module": "staff", "purpose": "Staff-location assignment" },
    { "name": "StaffCommission", "module": "staff", "purpose": "Commission record" },
    { "name": "InstructorPayout", "module": "staff", "purpose": "Payout record" },
    { "name": "Facility", "module": "facilities", "purpose": "Physical facility" },
    { "name": "Room", "module": "facilities", "purpose": "Room within facility" },
    { "name": "Resource", "module": "resources", "purpose": "Bookable resource" },
    { "name": "Course", "module": "courses", "purpose": "Activity type definition" },
    { "name": "Activity", "module": "activities", "purpose": "Specific activity offering" },
    { "name": "ClassSession", "module": "scheduling", "purpose": "Scheduled activity instance" },
    { "name": "RecurringSchedule", "module": "scheduling", "purpose": "Recurring schedule pattern" },
    { "name": "ScheduleException", "module": "scheduling", "purpose": "Schedule exception" },
    { "name": "Booking", "module": "bookings", "purpose": "Member reservation" },
    { "name": "WaitlistEntry", "module": "bookings", "purpose": "Waitlist position" },
    { "name": "MembershipProduct", "module": "memberships", "purpose": "Membership plan definition" },
    { "name": "Membership", "module": "memberships", "purpose": "Member subscription" },
    { "name": "MembershipFreeze", "module": "memberships", "purpose": "Membership freeze period" },
    { "name": "MembershipRenewal", "module": "memberships", "purpose": "Membership renewal record" },
    { "name": "MembershipCancellation", "module": "memberships", "purpose": "Membership cancellation record" },
    { "name": "Pass", "module": "passes", "purpose": "Credit-based pass" },
    { "name": "CreditTransaction", "module": "passes", "purpose": "Immutable credit ledger entry" },
    { "name": "Payment", "module": "payments", "purpose": "Payment record" },
    { "name": "Invoice", "module": "billing", "purpose": "Invoice document" },
    { "name": "InvoiceItem", "module": "billing", "purpose": "Invoice line item" },
    { "name": "Attendance", "module": "attendance", "purpose": "Check-in record" },
    { "name": "Lead", "module": "crm", "purpose": "CRM lead" },
    { "name": "Message", "module": "messaging", "purpose": "Communication message" },
    { "name": "MessageTemplate", "module": "messaging", "purpose": "Message template" },
    { "name": "Campaign", "module": "messaging", "purpose": "Messaging campaign" },
    { "name": "AutomationRule", "module": "automation", "purpose": "Automation configuration" },
    { "name": "AnalyticsEvent", "module": "analytics", "purpose": "Analytics event" },
    { "name": "Integration", "module": "integrations", "purpose": "Third-party integration" },
    { "name": "AuditLog", "module": "audit", "purpose": "Audit trail entry" }
  ],
  "relationships": [
    { "from": "Organization", "to": "Location", "type": "one-to-many" },
    { "from": "Organization", "to": "Member", "type": "one-to-many" },
    { "from": "Organization", "to": "Staff", "type": "one-to-many" },
    { "from": "Organization", "to": "Activity", "type": "one-to-many" },
    { "from": "Organization", "to": "Booking", "type": "one-to-many" },
    { "from": "Member", "to": "Booking", "type": "one-to-many" },
    { "from": "Member", "to": "Membership", "type": "one-to-many" },
    { "from": "Member", "to": "Pass", "type": "one-to-many" },
    { "from": "Member", "to": "Attendance", "type": "one-to-many" },
    { "from": "Activity", "to": "ClassSession", "type": "one-to-many" },
    { "from": "ClassSession", "to": "Booking", "type": "one-to-many" },
    { "from": "ClassSession", "to": "Attendance", "type": "one-to-many" },
    { "from": "Pass", "to": "CreditTransaction", "type": "one-to-many" },
    { "from": "Membership", "to": "MembershipFreeze", "type": "one-to-many" },
    { "from": "Membership", "to": "MembershipRenewal", "type": "one-to-many" },
    { "from": "Invoice", "to": "InvoiceItem", "type": "one-to-many" }
  ],
  "roles": [
    { "name": "OWNER", "permissions": ["*"] },
    { "name": "ADMIN", "permissions": ["organization.*", "members.*", "bookings.*", "payments.*"] },
    { "name": "MANAGER", "permissions": ["members.read", "bookings.*", "reports.read"] },
    { "name": "INSTRUCTOR", "permissions": ["schedule.read", "attendance.read"] },
    { "name": "STAFF", "permissions": ["members.read", "bookings.read"] },
    { "name": "MEMBER", "permissions": ["profile.read", "bookings.read", "bookings.write"] }
  ],
  "events": [
    "member.created",
    "member.updated",
    "membership.created",
    "membership.expiring",
    "membership.expired",
    "booking.created",
    "booking.cancelled",
    "waitlist.promoted",
    "payment.succeeded",
    "payment.failed",
    "attendance.recorded",
    "no.show.recorded"
  ],
  "integrations": [
    { "provider": "stripe", "type": "payment" },
    { "provider": "billingo", "type": "invoicing" },
    { "provider": "google_analytics", "type": "analytics" },
    { "provider": "meta", "type": "analytics" }
  ],
  "api": {
    "basePath": "/api/v1",
    "auth": "JWT Bearer",
    "pagination": "cursor-based",
    "versioning": "URL path"
  },
  "reports": [
    { "name": "revenue", "endpoint": "/reports/revenue" },
    { "name": "bookings", "endpoint": "/reports/bookings" },
    { "name": "members", "endpoint": "/reports/members" }
  ],
  "automations": [
    { "event": "MEMBERSHIP_EXPIRING", "action": "send_email" },
    { "event": "BOOKING_CREATED", "action": "send_confirmation" },
    { "event": "BOOKING_CANCELLED", "action": "notify_waitlist" }
  ]
}
